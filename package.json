{
  "name": "prottoyamin-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Production portfolio site with an owner-only admin panel for content management.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,mts,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,md,json,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:dummy": "node --conditions=react-server --import tsx scripts/seed-dummy.ts",
    "admin:reset": "node --conditions=react-server --import tsx scripts/reset-admin.ts",
    "atlas:provision": "node --conditions=react-server --import tsx scripts/atlas-provision.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "jose": "^6.2.18",
    "mongoose": "^9.12.2",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.37.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@10.34.9"
}

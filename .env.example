# ─────────────────────────────────────────────────────────────
#  Portfolio Platform — environment contract
#  Copy to `.env.local` and fill in. Never commit real values.
#  The app boots with ZERO credentials (memory driver + local
#  media + demo content) so you can run it before creating any
#  cloud account.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
# Canonical origin. Used for CSP, CSRF origin checks, OG URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# JWT signing key for admin sessions — generate with:
#   openssl rand -base64 48
# REQUIRED in production, >= 32 chars.
SESSION_SECRET=

# ── Database: MongoDB Atlas ──────────────────────────────────
# PRIMARY: SRV connection string with a Database Access user.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
# Get it from Atlas → Connect → Drivers → Node.js.
MONGODB_URI=
MONGODB_DB_NAME=portfolio

# Atlas Admin API key — ONLY used by `npm run atlas:provision`
# (creates the database user + IP allowlist and prints the URI).
# Note: the old Atlas Data API (api-key HTTP access) was retired
# on 30 Sep 2025 — the app connects with the native driver instead.
# Create one: Atlas → Project Settings → Service Accounts → API Keys.
MONGODB_ATLAS_API_KEY=
MONGODB_ATLAS_ORG_ID=
MONGODB_ATLAS_PROJECT_ID=
# Cluster to provision (optional).
MONGODB_ATLAS_CLUSTER_NAME=portfolio-cluster

# Driver selection: `mongo` | `memory`.
# Default: auto-detect (mongo if MONGODB_URI is set, else memory).
# `memory` is refused when NODE_ENV=production.
DB_DRIVER=

# ── Media: Cloudinary (free tier — 25 credits/month, no card) ─
# Dashboard → API Keys. 1 credit = 1GB storage OR 1GB bandwidth
# OR 1,000 transformations.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Driver selection: `cloudinary` | `local`.
# Default: auto-detect (cloudinary if credentials exist, else local).
MEDIA_DRIVER=

# ── Email: Resend (free tier — 3,000 mails/month) ────────────
# Used for contact-form delivery and password resets.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional override for the "from" address (must be a Resend domain).
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# ── First-boot admin bootstrap ───────────────────────────────
# On first boot, if no user exists, one is created with these
# values. The password is hashed immediately and never stored;
# delete the env vars afterwards.
ADMIN_EMAIL=md.jahid.bin.amin@gmail.com
ADMIN_PASSWORD=

# ── Misc ─────────────────────────────────────────────────────
# Set to `true` to allow demo content to be seeded in production.
SEED_DUMMY=false
# Turn on TOTP two-factor for the owner account.
TWO_FACTOR_ENABLED=false
